#!/usr/bin/env php
<?php

declare(strict_types=1);

$projectDirectory = \dirname(__DIR__);
$directories = [
    $projectDirectory.'/var',
    $projectDirectory.'/var/cache',
    $projectDirectory.'/var/log',
    $projectDirectory.'/storage/cache',
    $projectDirectory.'/storage/logs',
    $projectDirectory.'/storage/temp',
];

foreach ($directories as $directory) {
    if (!is_dir($directory) && !mkdir($directory, 0o777, true) && !is_dir($directory)) {
        throw new RuntimeException(sprintf('Unable to create runtime directory "%s".', $directory));
    }

    if (!chmod($directory, 0o777)) {
        throw new RuntimeException(sprintf('Unable to prepare runtime directory "%s".', $directory));
    }
}

fwrite(STDOUT, "Nexum runtime directories are ready for Fabryq Harbor.\n");
