{
    "name": "nexum/test-app",
    "description": "Integration application for testing all Nexum packages and supported project structures.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "nexum/filesystem": "^0.1",
        "nexum/mailer": "^0.1",
        "nexum/management": "^0.1",
        "nexum/pack-core": "^0.1",
        "nexum/qrcode": "^0.1",
        "nexum/security": "^0.1",
        "nexum/security-mfa": "^0.1",
        "nexum/security-passkey": "^0.1",
        "nexum/user": "^0.1",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/flex": "^2.6",
        "symfony/framework-bundle": "^7.4",
        "symfony/runtime": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "symlink": false
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "post-install-cmd": [
            "@php bin/prepare-runtime"
        ],
        "post-update-cmd": [
            "@php bin/prepare-runtime"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
