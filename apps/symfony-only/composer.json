{
    "name": "sillbeam/symfony-only-test-app",
    "description": "Standard Symfony application using Sillbeam without Modules or Projects.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "websign-dev/sillbeam": "^0.1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": { "symlink": true, "versions": { "websign-dev/sillbeam": "0.1.0" } }
        }
    ],
    "autoload": {
        "psr-4": {
            "SymfonyOnlyApp\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
