{
    "name": "sillbeam/single-project-test-app",
    "description": "Sillbeam single-project integration test application.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "websign-dev/sillbeam-core": "^0.3.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": { "symlink": true, "versions": { "websign-dev/sillbeam-core": "0.3.0" } }
        }
    ],
    "autoload": {
        "psr-4": {
            "SingleProjectApp\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
