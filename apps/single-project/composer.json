{
    "name": "nexum/single-project-test-app",
    "description": "Nexum single-project integration test application.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "benjaminoeffinger/nexum": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "SingleProjectApp\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
