{
    "name": "sillbeam/hybrid-test-app",
    "description": "Sillbeam hybrid Symfony and Projects integration test application.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "websign-dev/sillbeam": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "HybridApp\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
