{
    "name": "sillbeam/project-only-test-app",
    "description": "Sillbeam Project with direct Controller, Service and Entity directories and no Modules.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "websign-dev/sillbeam": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "ProjectOnlyApp\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
