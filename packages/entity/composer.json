{
    "name": "nexum/entity",
    "description": "Doctrine-mapped entity foundations and capability contracts for the Nexum framework.",
    "keywords": [
        "doctrine",
        "entity",
        "nexum",
        "uuid"
    ],
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "doctrine/orm": "^3.6",
        "nexum/core": "^0.1",
        "symfony/uid": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Nexum\\Entity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexum\\Entity\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
