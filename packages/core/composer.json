{
    "name": "nexum/core",
    "description": "Foundational contracts and shared primitives for the Nexum framework.",
    "keywords": [
        "contracts",
        "framework",
        "nexum",
        "php"
    ],
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Nexum\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexum\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
