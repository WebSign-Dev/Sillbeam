{
    "name": "nexum/security-mfa",
    "description": "Optional multi-factor authentication contracts and integration for Nexum Security.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "keywords": [
        "authentication",
        "mfa",
        "nexum",
        "recovery-codes",
        "security",
        "symfony",
        "totp",
        "two-factor"
    ],
    "require": {
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.0",
        "ext-sodium": "*",
        "php": "^8.4",
        "nexum/api": "^0.1",
        "nexum/entity": "^0.1",
        "nexum/security": "^0.1",
        "nexum/user": "^0.1",
        "spomky-labs/otphp": "^11.5",
        "symfony/cache-contracts": "^3.6",
        "symfony/clock": "^7.4",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-core": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Nexum\\Security\\Mfa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexum\\Security\\Mfa\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "nexum/qrcode": "Renders QR codes for TOTP enrollment URIs."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
