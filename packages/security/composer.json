{
    "name": "nexum/security",
    "description": "Backend authentication and authorization integration for Nexum applications.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "keywords": [
        "api",
        "authentication",
        "authorization",
        "nexum",
        "permissions",
        "security",
        "symfony"
    ],
    "require": {
        "php": "^8.4",
        "nexum/api": "^0.1",
        "nexum/core": "^0.1",
        "psr/clock": "^1.0",
        "symfony/clock": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/security-csrf": "^7.4",
        "symfony/security-http": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Nexum\\Security\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexum\\Security\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "ext-sodium": "Recommended for encrypting stored security credentials."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
