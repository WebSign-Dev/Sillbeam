{
    "name": "nexum/api",
    "description": "Convention-driven REST API resources and HTTP contracts for Nexum applications.",
    "type": "symfony-bundle",
    "keywords": [
        "nexum",
        "symfony",
        "api",
        "rest"
    ],
    "license": "proprietary",
    "require": {
        "doctrine/orm": "^3.6",
        "php": "^8.4",
        "nexum/core": "^0.1",
        "nexum/doctrine": "^0.1",
        "nexum/entity": "^0.1",
        "nexum/kernel": "^0.1",
        "psr/log": "^3.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/property-access": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/uid": "^7.4",
        "symfony/validator": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Nexum\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexum\\Api\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
