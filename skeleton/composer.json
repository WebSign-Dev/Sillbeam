{
    "name": "nexum/skeleton",
    "description": "Minimal project skeleton for creating modular Nexum applications.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "benjaminoeffinger/nexum": "^0.1",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/flex": "^2.6",
        "symfony/framework-bundle": "^7.4",
        "symfony/runtime": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
