{
    "name": "websign-dev/sillbeam",
    "description": "Modular architecture extension for Symfony applications, organized around Modules and optional Projects.",
    "type": "library",
    "keywords": [
        "modular-monolith",
        "modules",
        "sillbeam",
        "symfony"
    ],
    "license": "MIT",
    "require": {
        "composer-runtime-api": "^2.2",
        "nikic/php-parser": "^5.7",
        "php": "^8.4",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^2.0",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.6",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sillbeam\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/Fixtures/Application/src/",
            "HybridApp\\": "apps/hybrid/src/",
            "ModulesOnlyApp\\": "apps/modules-only/src/",
            "ProjectOnlyApp\\": "apps/project-only/src/",
            "ProjectApp\\": "apps/multi-project/src/",
            "SingleProjectApp\\": "apps/single-project/src/",
            "SymfonyOnlyApp\\": "apps/symfony-only/src/",
            "Sillbeam\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Enables automatic attribute mappings for active Sillbeam modules and projects."
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --debug",
        "architecture": "deptrac analyse --config-file=deptrac.yaml",
        "cs:check": "php-cs-fixer check --diff --config=.php-cs-fixer.dist.php --allow-unsupported-php-version=yes --sequential",
        "test": "phpunit --configuration=phpunit.xml.dist",
        "test:consumer": "php tools/test-consumer.php",
        "test:flex-recipe": "php tools/test-flex-recipe.php"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
