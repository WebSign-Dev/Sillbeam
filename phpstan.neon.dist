parameters:
    level: 8
    paths:
        - src
        - tests
        - apps/hybrid/src
        - apps/modules-only/src
        - apps/multi-project/src
        - apps/project-only/src
        - apps/single-project/src
        - apps/symfony-only/src
    tmpDir: .phpstan-cache
    treatPhpDocTypesAsCertain: false
    excludePaths:
        analyse:
            - tests/Fixtures/Application/var (?)
            - tests/Fixtures/*/config/reference.php (?)
            - apps/*/config/reference.php (?)
